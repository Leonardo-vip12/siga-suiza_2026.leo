# ============================================================
# Copia este archivo a ".env" y ajusta los valores.
# Docker Compose lee ".env" de la raiz para la substitucion de variables.
# ============================================================

# PostgreSQL local (pgAdmin) = fuente de verdad de los datos.
# "host.docker.internal" es el hostname que Docker Desktop usa para
# alcanzar el host desde dentro de un contenedor.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-this-secure-password
DB_NAME=siga_suiza_2026

# ============================================================
# Configuración de la aplicación
# ============================================================
APP_NAME=SIGA Core
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
DEBUG=True

# ============================================================
# Configuración NATS Event Bus
# ============================================================
NATS_URL=nats://localhost:4222
ENABLE_NATS=False

# ============================================================
# Configuración CORS para Render
# ============================================================
# Dominio del frontend en Render (establecido automáticamente o configurado aquí)
# Ejemplo: FRONTEND_ORIGIN=https://tu-app.onrender.com
FRONTEND_ORIGIN=https-tu-frontend-on-render.com

# ============================================================
# Variables para deployment en Render/Railway
# ============================================================
# Estas variables son inyectadas automaticamente por Render/Railway:
# - RENDER_EXTERNAL_URL: https://tu-app.onrender.com
# - RAILWAY_PUBLIC_DOMAIN: Tu dominio de Railway
# - PORT: Puerto assignado (8000 por defecto)

# ============================================================
# Variables de módulos (CRÍTICO para Render)
# ============================================================
# Los manifiestos de los módulos tienen endpoints con plantillas:
#   http://localhost:${PORT:-8001}
# Estas variables entorno leídas por _resolve_endpoints() en runtime.py
# reemplazan el hostname localhost por el dominio de Render.
#
# Opción A: Variable URL base (recomendado)
# Define un hostname base y los puertos se asignan automáticamente:
SIGA_MODULE_URL_BASE=https://tuservicio.onrender.com
# Esto seteará automáticamente:
#   SIGA_MODULE_USUARIOS_URL=https://tuservicio.onrender.com:8001
#   SIGA_MODULE_PLANES_ESTUDIO_URL=https://tuservicio.onrender.com:8002
#   SIGA_MODULE_PROGRAMAS_ESTUDIO_URL=https://tuservicio.onrender.com:8005
#   SIGA_MODULE_GESTION_ACADEMICA_URL=https://tuservicio.onrender.com:8006
#   SIGA_MODULE_AUDITORIA_URL=https://tuservicio.onrender.com:8007
#   SIGA_MODULE_EVALUACION_URL=https://tuservicio.onrender.com:8008
#   SIGA_MODULE_ADMISION_URL=https://tuservicio.onrender.com:8009

# Opción B: Variables individuales (alternativa)
# Descomenta y ajusta solo las que necesites:
# SIGA_MODULE_USUARIOS_URL=https://tuservicio.onrender.com:8001
# SIGA_MODULE_PLANES_ESTUDIO_URL=https://tuservicio.onrender.com:8002
# SIGA_MODULE_PROGRAMAS_ESTUDIO_URL=https://tuservicio.onrender.com:8005
# SIGA_MODULE_GESTION_ACADEMICA_URL=https://tuservicio.onrender.com:8006
# SIGA_MODULE_AUDITORIA_URL=https://tuservicio.onrender.com:8007
# SIGA_MODULE_EVALUACION_URL=https://tuservicio.onrender.com:8008
# SIGA_MODULE_ADMISION_URL=https://tuservicio.onrender.com:8009

# Si NO se definen estas variables, los módulos quedarán con URLs a localhost
# y quedarán en estado OFFLINE (funcionalidad completa sin módulos externos).

# ============================================================
# Frontend (Vite)
# ============================================================
# Estas variables son leídas por el frontend en src/core/api/client.jsx:
# VITE_API_URL - URL base de la API backend
# VITE_WS_URL - URL base de WebSocket
# Dejarlas con valores por defecto para desarrollo local:
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Para producción en Render, sobreescribir con:
# VITE_API_URL=https://tu-backend-on-render.com
# VITE_WS_URL=wss://tu-backend-on-render.com