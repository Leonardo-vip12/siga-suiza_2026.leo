# 🎯 Configuración para Render Single-Container
# NOTA: En Render single-container, todos los módulos corren dentro del mismo
# contenedor principal. No hay configuración de BD/puerto por módulo porque:
# - Todos comparten la misma base de datos central
# - Las URLs se resuelven automaticamente via SIGA_MODULE_URL_BASE
# - No configurar variables por módulo - usar la variable global en su lugar

# Variable OBLIGATORIA en Render Dashboard:
# SIGA_MODULE_URL_BASE=https://TU-SUBDOMINIO.onrender.com
#
# Sin esta variable, los módulos tendrán URLs rotas http://localhost:${PORT:-8001}
# y la resolucion fallara.

# Las siguientes variables NUNCA configurar por modulo en Render:
# - DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME -> Compartidas centralmente
# - Puerto 8001-8009 -> No se usan; todo en puerto 8000 principal

echo "Configuración Render single-container listo."