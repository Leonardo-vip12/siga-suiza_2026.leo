# 🎯 Configuración para Render Deployment
# Copiar a .env y completar. NUNCA subir el .env real.
# Variables inyectadas automáticamente por Render (no editar):
# - DATABASE_URL: Render la inyecta automaticamente para PostgreSQL
# - PORT: Render la inyecta automaticamente

# Configuración obligatoria en Render Dashboard (Environment variables):
# SIGA_MODULE_URL_BASE=https://TU-SUBDOMINIO.onrender.com
# ESTA ES LA VARIABLE CRITICA: hace que las plantillas http://localhost:${PORT:-8001}
# en los manifiestos de módulos se conviertan automaticamente a tu dominio Render.

# Configuración del frontend (agregar en panel de Render Frontend):
# VITE_API_URL=https://TU-SUBDOMINIO.onrender.com
# VITE_WS_URL=wss://TU-SUBDOMINIO.onrender.com

APP_NAME=SIGA Core
ENVIRONMENT=production
DEBUG=False

# Seguros - Render inyecta estos automaticamente:
# DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME -> a traves de DATABASE_URL

# Módulos: en Render single-container, las URLs se resuelven via SIGA_MODULE_URL_BASE
# en runtime.py. No necesitar MODULES_AUTO_DISCOVER complejo.
MODULES_AUTO_DISCOVER=True
MODULES_VALIDATE_ON_START=True

# NATS/Event Bus: desactivado para Render single-container
NATS_URL=nats://localhost:4222
ENABLE_NATS=False